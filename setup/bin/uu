#!/usr/bin/env bash
# uu — uumami_os umbrella CLI. DETERMINISTIC FACADE: every verb routes to an existing
# setup/lib script or composes documented podman/distrobox one-liners. No business logic
# here; uu never calls a model or agent. Spec: docs/superpowers/specs/2026-07-01-uu-cli-design.md
# Exit codes: 0 done · 2 human-required (instructions printed) · 3 precondition failed · 1 error.
set -uo pipefail
UU_VERSION="1.0.0"

# ---------- core helpers ----------
die()  { printf 'uu: %s\n' "$1" >&2; [ -n "${2:-}" ] && printf 'hint: %s\n' "$2" >&2; exit "${3:-1}"; }
pre()  { die "$1" "${2:-}" 3; }
have() { command -v "$1" >/dev/null 2>&1; }
in_box()   { [ -f /run/.containerenv ]; }
box_name() { sed -n 's/^name="\(.*\)"/\1/p' /run/.containerenv 2>/dev/null; }
host_run() { if in_box; then distrobox-host-exec "$@"; else "$@"; fi; }
json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; s=${s//$'\t'/ }; printf '%s' "$s"; }

# ---------- safe host calls ----------
# Every host command is BOUNDED (timeout) and NON-INTERACTIVE (stdin closed). Rationale:
# `distrobox enter <missing-box>` PROMPTS "Create it now, out of image fedora-toolbox? [Y/n]"
# on stderr. In a command substitution that prompt is invisible and blocks forever — and
# answering yes silently creates a WRONG box. uu must never reach that prompt: check the
# container exists first, and never leave stdin open to a host command.
UU_TIMEOUT="${UU_TIMEOUT:-10}"
hq()  { host_run timeout "$UU_TIMEOUT" "$@" </dev/null 2>/dev/null; }   # quiet+bounded
hqq() { host_run timeout "${1}" "${@:2}" </dev/null 2>/dev/null; }      # explicit timeout
box_exists()  { hq podman container exists "$1"; }
have_host()   { hq command -v "$1" >/dev/null; }

# llm_api <path> — talk to the model server over loopback. Never enters a box (fast, and
# impossible to trigger the create-prompt). Returns 1 if the endpoint is down.
llm_api() { curl -fsS --max-time "${UU_HTTP_TIMEOUT:-2}" "http://127.0.0.1:11434$1" 2>/dev/null; }

# llm_box_run <args...> — run a command inside llm_server, only if that box really exists.
llm_box_run() {
  box_exists llm_server || pre "the llm_server box does not exist yet" \
    "set it up first: uu setup   (or: bash setup/lib/llm_server.sh on the host)"
  host_run distrobox enter llm_server -- "$@"
}

repo_root() {
  local cand
  # 1. explicit override
  if [ -n "${UU_REPO:-}" ] && [ -d "$UU_REPO/setup/lib" ]; then printf '%s' "$UU_REPO"; return 0; fi
  # 2. relative to this script — AUTHORITATIVE when it resolves, because the file you invoked
  #    is unambiguously part of that repo. This must outrank the pointer file: a stale pointer
  #    (left by an old install, a moved folder, a throwaway copy) would otherwise silently send
  #    build/validate/rebuild to a DIFFERENT copy of the project than the one you are looking
  #    at — the single most confusing failure mode this project has.
  local self
  self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
  cand="$(cd "$(dirname "$self")/../.." 2>/dev/null && pwd)" || cand=""
  [ -n "$cand" ] && [ -d "$cand/setup/lib" ] && { printf '%s' "$cand"; return 0; }
  # 3. pointer file recorded by deploy-uu.sh — the fallback for an installed COPY of uu, which
  #    lives in ~/.local/bin and is genuinely detached from any repo tree. Verified before use.
  local ptr="${XDG_CONFIG_HOME:-$HOME/.config}/uumami/repo"
  if [ -f "$ptr" ]; then cand="$(cat "$ptr" 2>/dev/null)"; [ -n "$cand" ] && [ -d "$cand/setup/lib" ] && { printf '%s' "$cand"; return 0; }; fi
  # 4. common mount points (os_agent mounts ~/Code/system -> /workspace; repo lives under it)
  for cand in "$HOME/Containers" "$HOME/Code/system/uumami_os" /workspace/uumami_os; do
    [ -d "$cand/setup/lib" ] && { printf '%s' "$cand"; return 0; }
  done
  return 1
}
need_repo() {
  export REPO; REPO="$(repo_root)" || pre "this verb needs the uumami_os repo (setup/lib), which is not reachable" \
    "set UU_REPO=/path/to/repo, or run this verb from the admin account"
}

# ---------- verb registry ----------
ALL_VERBS=(setup status enter agent work tenant models clean rebuild recreate build logs github \
           repair bootstrap validate doctor aliases help)

# The box that maintains this system. `uu agent` always lands here — see cmd_agent.
ADMIN_BOX=os_agent

verb_summary() {
  case "$1" in
    setup)     echo "install or continue the setup, step by step (safe to re-run)" ;;
    repair)    echo "fix a broken profile: reinstall shortcuts, uu and config pointers" ;;
    status)    echo "everything at a glance: boxes, llm service/GPU, disk, pending recreates" ;;
    enter)     echo "enter a box (default: os_agent)" ;;
    agent)     echo "launch a coding agent in the repo (any agent; --sessions to resume)" ;;
    work)      echo "launch a named session inside this box (work --list to see them)" ;;
    tenant)    echo "isolated project spaces: new / ls / rm" ;;
    models)    echo "models on the shared server: ls / pull / rm" ;;
    clean)     echo "safe disk cleanup (dangling images only; plan shown first)" ;;
    rebuild)   echo "rebuild dev_base + derived images; prints recreate steps" ;;
    recreate)  echo "recreate one box from its image (profile survives)" ;;
    build)     echo "assemble + build one image (dev_base, os_agent, per-project)" ;;
    logs)      echo "llm_server journal (add -f to follow)" ;;
    github)    echo "finish the per-profile GitHub SSH setup" ;;
    bootstrap) echo "first-time setup: probe machine, match flavor, validate config" ;;
    validate)  echo "fast check: is my config/flavors correct?" ;;
    doctor)    echo "full health check (selftest; --quick to skip heavy checks)" ;;
    aliases)   echo "show the shell-alias catalog (uu aliases agents|git|gh|tmux|containers|llm)" ;;
    help)      echo "this screen; 'uu help <command>' for details + examples" ;;
    *)         return 1 ;;
  esac
}

overview() {
  cat <<EOF
uu — your local AI dev environment  (v$UU_VERSION)

Getting set up
  uu setup         $(verb_summary setup)
  uu repair        $(verb_summary repair)

See what's going on
  uu status        $(verb_summary status)
  uu doctor        $(verb_summary doctor)
  uu validate      $(verb_summary validate)
  uu logs          $(verb_summary logs)

Daily work
  uu enter [box]   $(verb_summary enter)
  uu agent [name]  $(verb_summary agent)
  uu work <name>   $(verb_summary work)
  uu models        $(verb_summary models)
  uu aliases       $(verb_summary aliases)

Projects & tenants
  uu tenant new <name>   create an isolated project space (guided)
  uu tenant ls           list tenants and their boxes
  uu tenant rm <name>    decommission a tenant (guided, step by step)
  uu build <image>       $(verb_summary build)

Maintenance & setup
  uu clean         $(verb_summary clean)
  uu rebuild       $(verb_summary rebuild)
  uu recreate <box> $(verb_summary recreate)
  uu bootstrap     $(verb_summary bootstrap)
  uu github        $(verb_summary github)

Common tasks:  first time here? -> uu setup      disk filling up? -> uu clean --dry-run
               new project?     -> uu tenant new my-project
Details and examples:  uu help <command>        Agents/scripts: uu help --agent
EOF
}

verb_help() {
  case "$1" in
    setup) cat <<'EOF'
uu setup [--status] [--dry-run] [--yes]
  What it does: runs the guided installer. It checks your machine can run this, puts the
  files in the right place, works out your hardware settings, builds the model server and
  your dev box, and installs the shortcuts. It asks before every change.
  Safe to re-run: it continues where it stopped and repairs what is broken — it never
  starts over and never deletes your work.
  Touches: images, boxes, ~/.local/bin, your profile. Never: your code, your credentials.
  Flags: --status (just show what is done) · --dry-run (show, change nothing) · --yes (no questions)
  Exit codes: 0 done · 2 needs you to do something (it says exactly what) · 1 error
  Examples:
    uu setup                 # start, or continue where you left off
    uu setup --status        # what is done so far?
    uu setup --dry-run       # see every action first, change nothing
  See also: uu repair (fix shortcuts only) · uu doctor (health check) · uu status
EOF
      ;;
    repair) cat <<'EOF'
uu repair
  What it does: reinstalls the things that commonly go missing in a profile — the shell
  shortcuts, the `uu` command itself, the tmux config and the pointer to the project files.
  Use it when shortcuts like `cl`, `gs` or `llm-ps` are "command not found" inside a box.
  Touches: ~/.bashrc.d, ~/.config/uumami, ~/.local/bin in the profile it is run from.
  Builds nothing. Deletes nothing. Safe to run any number of times.
  Exit codes: 0 done · 1 error
  Examples:
    uu repair                # fix this profile
    exec bash                # then reload the shell so shortcuts take effect
  See also: uu setup · uu aliases (what shortcuts exist)
EOF
      ;;
    status) cat <<'EOF'
uu status [--json]
  What it does: one-glance health of the whole system — every box and the tenant it belongs
  to; whether the llm_server service is active, its endpoint is up, and the loaded model
  runs on GPU (not CPU fallback); a disk summary; whether your config validates; and DRIFT
  DETECTION — a box created before its current image is flagged "RECREATE PENDING" (a
  rebuild landed but the box still runs the old image).
  Touches: nothing — fully read-only, safe anytime.
  --json: {context, llm{service,endpoint,models,processor}, disk, config, boxes[{name,image,drift}]}.
Examples:
  uu status                                            # the human dashboard
  uu status --json | jq .llm                           # just inference status
  uu status --json | jq '.boxes[]|select(.drift=="yes")'   # boxes needing a recreate
Underneath: distrobox list, podman inspect/system df, systemctl --user, setup/lib/validate.sh
See also: uu doctor (deep health), uu recreate (act on drift)
EOF
    ;;
    agent) cat <<'EOF'
uu agent [name] [-c | -r | --session <id>] [-- agent args]
  What it does: launches a coding agent ON THIS PROJECT — always in the os_agent box, always
  in the repo root, whichever side you type it from. Fixing the directory is the point: agents
  index their history by the folder they started in, so one folder means one session list you
  can always find again (uu agent --sessions).
  The agent list comes from the agents.* toggles in config.yaml, so a newly enabled agent shows
  up here on its own.
  Touches: nothing. It only enters a box and starts a program.
Flags:
  --list             which agents are enabled, and whether each is installed here
  --sessions         recoverable sessions for this project, newest first, with an excerpt
  --session <id>     resume that exact session
  -c, --continue     continue the most recent session
  -r, --resume       the agent's own session picker
  -- <args>          everything after -- is passed to the agent untouched
Examples:
  uu agent                        # default agent, in the repo
  uu agent codex                  # a different agent, same place
  uu agent --list
  uu agent --sessions             # "which conversation was that?"
  uu agent claude --session f8bae65f-e0d1-402a-8282-334eabc491e2
  uu agent claude -- --model opus
Exit codes: 3 if run from a box that is not os_agent (a tenant box is another trust domain,
  and the project is read-only there), if the agent is not enabled, or if resuming is not
  wired up for that agent. Resume is only claimed for agents where it has been verified.
See also: uu work (sessions inside a tenant box) · uu aliases agents (per-agent shortcuts)
Underneath: distrobox enter os_agent -- bash -lc 'cd <repo>; exec <agent> ...'
EOF
      ;;
    enter) cat <<'EOF'
uu enter [box]
  What it does: opens an interactive shell inside a box (default: os_agent). This is where
  you work — your agents, your code at /workspace, the shared aliases. Run from a HOST
  terminal; from inside a box, exit first (a box can't enter another).
  Touches: nothing.
Examples:
  uu enter                # your personal box (os_agent)
  uu enter llm_server     # poke at the model server directly
Exit codes: 3 if you're already inside a box, or the box doesn't exist (with a hint).
Underneath: distrobox enter <box>
EOF
    ;;
    work) cat <<'EOF'
uu work <session> | uu work --list
  What it does: launches a named work SESSION inside a tenant box — sets that session's
  model / working dir / browser profile (from the tenant manifest) and attaches its tmux
  session. Sessions are lightweight contexts within one identity (e.g. acme-opus vs
  acme-cheap): same credentials + code, different model/dir. In-box only.
  Touches: nothing persistent (starts/attaches a tmux session).
Examples:
  uu work --list          # sessions defined for this tenant
  uu work acme-main       # attach or create that session
Exit codes: 3 on the host (work is in-box only) or for an unknown session name.
Underneath: the deployed `work` launcher (setup/lib/work.sh) + ~/.config/uumami/tenant.yaml
See also: uu tenant new (defines the sessions)
EOF
    ;;
    tenant) cat <<'EOF'
uu tenant new <name> [--tier 0|2a] [--manifest f.yaml] [--yes] [--dry-run]
uu tenant ls [--json]
uu tenant rm <name> [--profile] [--yes] [--dry-run]
  What it does: manage isolated project/client spaces. A tenant bundles ONE identity — its
  own credentials, code, config, browser — walled from the rest.
    new : Tier 0 = a box under YOUR user (max convenience). Tier 2a (default) = a dedicated
          Linux USER + box (kernel-enforced wall). The user-creation step needs sudo, so uu
          PRINTS the exact commands and exits 2 — it never runs sudo for you.
    ls  : the registry — name, user, tier, image.
    rm  : the decommission checklist — box -> tenant images -> registry entry. It NEVER
          deletes the profile (credentials) unless you pass --profile AND retype the tenant
          name; that step has no undo, and the retype is required even with --yes.
  Never touches: another tenant, the models, or your code.
Flags: --dry-run (preview the whole plan, change nothing) · --yes (skip the confirm) ·
  --tier 0|2a · --manifest (a full manifest instead of the guided minimal one — see
  setup/templates/tenant-example.yaml).
Examples:
  uu tenant new acme                  # guided, Tier 2a (prints the sudo user-creation)
  uu tenant new scratch --tier 0      # quick personal box, no sudo
  uu tenant new acme --dry-run        # every action, before doing any
  uu tenant ls --json
  uu tenant rm scratch --dry-run      # preview; nothing removed
Exit codes: 2 when a sudo step is required (instructions printed); 3 on a bad name.
Underneath: setup/lib/tenant-create.sh, <profiles>/registry.yaml
See also: docs/per-project-workflow.md, docs/housekeeping.md (decommission)
EOF
    ;;
    models) cat <<'EOF'
uu models [ls] [--json] | uu models pull <name> | uu models rm <name>
  What it does: manage the models on the shared llm_server. Models live ONCE on the server;
  every box uses them over loopback (127.0.0.1:11434) — weights are never copied per box.
  Touches: only the shared model store (pull downloads, rm removes); never a box or profile.
Examples:
  uu models                        # what's available
  uu models --json | jq .models    # machine-readable
  uu models pull qwen3-coder:30b   # download a model
  uu models rm old-model:7b        # free its disk
Exit codes: 3 if the endpoint isn't responding (see: uu logs, uu status).
Underneath: distrobox enter llm_server -- ollama {list,pull,rm}; /api/tags for --json
EOF
    ;;
    clean) cat <<'EOF'
uu clean [--dry-run] [--yes]
  What it does: the safe housekeeping routine. Removes DANGLING images only (untagged
  rebuild leftovers). It NEVER runs `prune -a`, never removes tagged images, and never
  touches profiles/models/code (a different storage pool). Tagged-but-unused images are
  LISTED for your review, not removed. In-use images (a running box needs them) are kept.
  Always shows the plan first, prefixed:  would: / review: / keeping: / untouched:.
Flags: --dry-run (plan only, change nothing) · --yes (skip the confirm; for scripts/agents).
Examples:
  uu clean --dry-run   # exactly what would happen, nothing removed
  uu clean             # asks before pruning
  uu clean --yes       # unattended
Underneath: podman image prune (dangling only) + a review listing
See also: docs/housekeeping.md (why RECLAIMABLE lies; the three storage pools)
EOF
    ;;
    rebuild) cat <<'EOF'
uu rebuild [--dry-run]
  What it does: the propagation cascade. Rebuilds dev_base, then every image derived from it
  (os_agent + tenant images), then PRINTS the recreate commands — it does NOT recreate boxes
  for you (a box can't recreate itself, and tenant boxes belong to other users). Run
  `uu clean` afterwards to drop the now-dangling old images.
  Touches: builds images (safe, reversible); prints — never runs — box recreates.
Examples:
  uu rebuild --dry-run   # what it would build + the recreate steps
  uu rebuild             # build the cascade
Underneath: setup/lib/rebuild.sh
See also: uu recreate, docs/propagating-fixes.md
EOF
    ;;
    recreate) cat <<'EOF'
uu recreate <box> [--yes] [--dry-run]
  What it does: recreate one box from its (possibly newer) image — this is how a rebuilt
  image reaches a running box. The profile + code mounts SURVIVE — uu never uses --rm-home
  (deleting the profile). You CANNOT recreate the box you're inside (it would kill your
  session) -> exit 2 with host-terminal instructions; a tenant box belongs to another user
  -> exit 2 with per-user instructions.
Flags: --dry-run (show the plan) · --yes (skip the confirm).
Examples:
  uu recreate llm_server            # safe: not the box you're in
  uu recreate os_agent              # run from a HOST terminal (not inside os_agent)
  uu recreate os_agent --dry-run    # preview
Exit codes: 2 when it must be run elsewhere (host terminal / as the tenant user).
Underneath: setup/lib/llm_server.sh, documented distrobox rm+create (never --rm-home)
EOF
    ;;
    build) cat <<'EOF'
uu build <image>
  What it does: (re)generate an image's Containerfile from its .layer modules (honoring your
  config.yaml toggles) and build it. Use for dev_base, os_agent, or a per-project image.
  Building doesn't touch running boxes — run `uu recreate <box>` after to adopt it.
Examples:
  uu build dev_base
  uu build os_agent
  uu build acme        # a per-project image FROM dev_base
Exit codes: 3 if no image name is given, or the repo isn't reachable.
Underneath: setup/lib/build.sh (assemble.sh -> podman build)
See also: docs/per-project-workflow.md (#3 per-project images)
EOF
    ;;
    logs) cat <<'EOF'
uu logs [-f] [-n N]
  What it does: tail the llm_server service journal — the first stop when the inference
  endpoint is down or a model won't load.
Flags: -f (follow live) · -n N (last N lines; default 50).
Examples:
  uu logs              # recent lines
  uu logs -f           # follow
  uu logs -n 200       # more history
Exit codes: 3 on a bad flag (e.g. -n with no number).
Underneath: journalctl --user -u llm_server
See also: uu status (is it active?), uu doctor
EOF
    ;;
    github) cat <<'EOF'
uu github
  What it does: shows this profile's GitHub SSH state (the key + the ~/.ssh/config block) and
  the two steps to finish — add the public key to GitHub, then test. The key is generated
  per profile by deploy-ssh at setup (one identity per tenant; keys are never shared).
Examples:
  uu github
  cat ~/.ssh/id_ed25519_github.pub    # the pubkey to paste into GitHub
Exit codes: 3 if the key is missing (hint: run deploy-ssh).
Underneath: setup/lib/deploy-ssh.sh artifacts in ~/.ssh
EOF
    ;;
    bootstrap) cat <<'EOF'
uu bootstrap
  What it does: the first-time entry point. Probes this machine (read-only), matches a
  hardware flavor or WRITES a browser-AI prompt (setup/flavor-request.md) so you can get one,
  then validates config.yaml. On the reference machine it just confirms PASS.
Examples:
  uu bootstrap
Underneath: setup/lib/bootstrap.sh (detect.sh + validate.sh)
See also: docs/porting-guide.md (bringing a new machine/OS)
EOF
    ;;
    validate) cat <<'EOF'
uu validate
  What it does: fast (~1s) config check — schema, layer purity (no hardware values in the
  general config), no secrets, and toggle<->module coherence. Answers "is my CONFIG right?".
  For "is my whole SYSTEM healthy?" use `uu doctor`.
Examples:
  uu validate
Exit codes: nonzero if the config is invalid (each violation is listed).
Underneath: setup/lib/validate.sh
See also: uu doctor
EOF
    ;;
    doctor) cat <<'EOF'
uu doctor [--quick]
  What it does: the deep health check — runs the full end-to-end self-test (images present,
  every agent works, LIVE GPU inference, tenant logic, architecture invariants) and gives a
  plain-language verdict. --quick skips the heavy live checks (inference + throwaway box).
Examples:
  uu doctor --quick     # fast sanity (seconds)
  uu doctor             # full (a real inference + a throwaway tenant)
Exit codes: nonzero if any check fails (the failing lines + next-step hints are shown).
Underneath: setup/test/selftest.sh
See also: uu validate (config only), docs/validation-runbook.md (human-required checks)
EOF
    ;;
    aliases) cat <<'EOF'
uu aliases [category] [--json]
  What it does: print the shell-alias catalog, grouped. These are muscle-memory shortcuts
  active in interactive shells INSIDE a box (deployed per profile by deploy-aliases.sh). This
  reads the annotations in the aliases file — the file is the single source of truth.
  Categories: agents git gh tmux containers llm.
  Note: agent aliases (cl, co, …) only work inside a box, where the agents are installed —
  not on the host.
Examples:
  uu aliases              # the whole catalog
  uu aliases agents       # just the agent-launcher shortcuts (cl, clc, coo, …)
  uu aliases --json | jq  # machine-readable
Underneath: annotations in ~/.config/uumami/aliases.sh (deployed by deploy-aliases.sh)
EOF
    ;;
    help) overview ;;
    *) return 1 ;;
  esac
}

agent_help() {
  cat <<EOF
uu machine contract (v$UU_VERSION) — deterministic: uu NEVER calls a model or agent; output
is ground truth about the system.
EXIT CODES: 0=done 2=human-required(instructions were printed) 3=precondition-failed 1=error
MUTATING VERBS (clean, recreate, tenant new, tenant rm): --dry-run prints the plan (exit 0);
--yes skips confirmation. Plan lines are prefixed: 'would:' 'keeping:' 'review:' 'untouched:'.
tenant rm --profile ALWAYS prompts for the tenant name retype, even with --yes.
READ VERBS with --json (stable keys, no ANSI): status, tenant ls, models, aliases.
FORBIDDEN BY VOCABULARY: uu never uses prune -a, --rm-home, or writes under ~/Profiles or ~/Models content.
VERBS:
EOF
  local v; for v in "${ALL_VERBS[@]}"; do printf '  %-10s %s\n' "$v" "$(verb_summary "$v")"; done
}

suggest() {  # did-you-mean for an unknown verb
  local bad="$1" v out=""
  for v in "${ALL_VERBS[@]}"; do
    case "$v" in "$bad"*|*"$bad"*|"${bad:0:3}"*) out="$v"; break;; esac
  done
  [ -z "$out" ] && case "$bad" in
    rm|remove|delete) out="tenant rm";; new|create|add) out="tenant new";;
    ls|list) out="status";; model) out="models";; alias) out="aliases";;
    check|test) out="doctor";; update|upgrade) out="rebuild";;
  esac
  [ -n "$out" ] && printf 'did you mean: uu %s ?\n' "$out" >&2
  printf 'hint: run `uu` for the command list\n' >&2
}

# ---------- status / logs ----------
drift_of() {  # container image -> yes|no|unknown (image newer than container = recreate pending)
  local cc ic cs is
  cc="$(hq podman inspect "$1" --format '{{.Created}}')" || { echo unknown; return; }
  ic="$(hq podman image inspect "$2" --format '{{.Created}}')" || { echo unknown; return; }
  cc="$(printf '%s' "$cc" | sed 's/ [A-Z][A-Z]*$//')"; ic="$(printf '%s' "$ic" | sed 's/ [A-Z][A-Z]*$//')"
  cs="$(date -d "$cc" +%s 2>/dev/null || echo 0)"; is="$(date -d "$ic" +%s 2>/dev/null || echo 0)"
  if [ "$cs" -eq 0 ] || [ "$is" -eq 0 ]; then echo unknown; return; fi
  if [ "$is" -gt "$cs" ]; then echo yes; else echo no; fi
}

cmd_status() {
  local as_json=no; [ "${1:-}" = --json ] && as_json=yes
  local ctx="host"; in_box && ctx="box:$(box_name)"

  # --- prerequisites: report them as state, never as a crash -----------------
  local have_podman=no have_distrobox=no
  have_host podman    && have_podman=yes
  have_host distrobox && have_distrobox=yes

  # boxes: name image (skip header). Empty when distrobox is not installed.
  local boxes_raw=""
  [ "$have_distrobox" = yes ] && boxes_raw="$(hq distrobox list --no-color | awk -F'|' 'NR>1{gsub(/ /,"",$2); gsub(/ /,"",$4); if($2!="") print $2, $4}')"

  # llm service + endpoint + processor. All over loopback HTTP — we never `distrobox enter`
  # llm_server here (a missing box would prompt to create itself and hang; see llm_api).
  local svc="inactive"; hq systemctl --user is-active llm_server.service >/dev/null && svc="active"
  local endpoint="down" nmodels=0 tags
  if tags="$(llm_api /api/tags)"; then
    endpoint="up"; nmodels="$(printf '%s' "$tags" | grep -o '"name"' | wc -l | tr -d ' ')"
  fi
  local proc="idle" ps_json size vram
  if [ "$endpoint" = up ] && ps_json="$(llm_api /api/ps)"; then
    size="$(printf '%s' "$ps_json" | grep -o '"size":[0-9]*'      | head -1 | cut -d: -f2)"
    vram="$(printf '%s' "$ps_json" | grep -o '"size_vram":[0-9]*' | head -1 | cut -d: -f2)"
    if [ -n "${size:-}" ] && [ "${size:-0}" -gt 0 ] 2>/dev/null; then
      if   [ "${vram:-0}" -ge "$size" ]; then proc="100% GPU"
      elif [ "${vram:-0}" -eq 0 ];       then proc="100% CPU (no GPU offload!)"
      else proc="$(( vram * 100 / size ))% GPU"; fi
    fi
  fi
  # disk (Images row of podman system df)
  local disk=""
  [ "$have_podman" = yes ] && disk="$(hqq 20 podman system df | awk '/^Images/{print $4" used, "$5" "$6" reclaimable"}')"
  # config validity (only when repo reachable)
  local cfg="unknown" r
  r="$(repo_root)" && { hqq 30 bash "$r/setup/lib/validate.sh" >/dev/null && cfg=valid || cfg=INVALID; }
  if [ "$as_json" = yes ]; then
    printf '{"context":"%s","prereqs":{"podman":"%s","distrobox":"%s"},"llm":{"service":"%s","endpoint":"%s","models":%s,"processor":"%s"},"disk":"%s","config":"%s","boxes":[' \
      "$(json_escape "$ctx")" "$have_podman" "$have_distrobox" \
      "$svc" "$endpoint" "${nmodels:-0}" "$(json_escape "$proc")" "$(json_escape "${disk:-}")" "$cfg"
    local first=yes name img
    while read -r name img; do
      [ -z "$name" ] && continue
      [ "$first" = yes ] || printf ','; first=no
      printf '{"name":"%s","image":"%s","drift":"%s"}' "$(json_escape "$name")" "$(json_escape "$img")" "$(drift_of "$name" "$img")"
    done <<< "$boxes_raw"
    printf ']}\n'; return 0
  fi
  echo "context : $ctx"
  if [ "$have_podman" = no ] || [ "$have_distrobox" = no ]; then
    local missing=""
    [ "$have_podman" = no ]    && missing="podman"
    [ "$have_distrobox" = no ] && missing="${missing:+$missing }distrobox"
    echo "prereqs : MISSING on the host — $missing"
  fi
  echo "llm     : service=$svc endpoint=$endpoint models=$nmodels processor=$proc"
  echo "disk    : ${disk:-n/a}"
  echo "config  : $cfg"
  echo "boxes   :"
  local name img d wrong=""
  while read -r name img; do
    [ -z "$name" ] && continue
    # A box built from the wrong image is worse than a missing one: it looks installed and
    # behaves like an empty Fedora shell. It happens when distrobox's "create it now, out of
    # fedora-toolbox?" prompt gets answered yes for a box that was never built.
    case "$name" in
      llm_server|os_agent|dev_base)
        if [ "$img" != "localhost/$name:latest" ]; then
          printf '  %-14s %-34s WRONG IMAGE — this box is not what it claims to be\n' "$name" "$img"
          wrong="${wrong:+$wrong }$name"
          continue
        fi ;;
    esac
    d="$(drift_of "$name" "$img")"
    if [ "$d" = yes ]; then
      printf '  %-14s %-34s RECREATE PENDING (image is newer)\n' "$name" "$img"
    else
      printf '  %-14s %s\n' "$name" "$img"
    fi
  done <<< "$boxes_raw"
  if [ -n "$wrong" ]; then
    echo
    echo "  ! '$wrong' was created from a generic image instead of being built."
    echo "    It contains nothing useful and will fail in confusing ways. Delete it —"
    echo "    this is safe, there is nothing in it to lose:"
    for name in $wrong; do echo "        distrobox rm -f $name"; done
    echo "    then build it properly:  uu setup"
  fi
  if printf '%s' "$boxes_raw" | grep -q .; then :; else echo "  (none yet)"; fi
  echo
  # --- next step: always tell the user what to do, never just dump state -----
  local next
  if   [ "$have_podman" = no ] || [ "$have_distrobox" = no ]; then
    next="install the missing host prerequisites -> uu setup   (it prints the exact commands)"
  elif [ -n "$wrong" ]; then
    next="delete the wrongly-created box(es) shown above, then run uu setup"
  elif [ "$cfg" = INVALID ]; then
    next="your config has errors -> uu validate   (shows each one)"
  elif ! printf '%s' "$boxes_raw" | grep -q llm_server; then
    next="the model server is not set up yet -> uu setup"
  elif [ "$svc" != active ] || [ "$endpoint" = down ]; then
    next="the model server is not running -> uu setup   (or: uu logs to see why)"
  elif [ "$nmodels" -eq 0 ]; then
    next="no models downloaded yet -> uu models pull <name>   (uu setup does this for you)"
  elif ! printf '%s' "$boxes_raw" | grep -q os_agent; then
    next="your personal dev box is missing -> uu setup"
  elif printf '%s' "$proc" | grep -q CPU; then
    next="the model is running on CPU, not GPU -> uu doctor   (this is the classic silent failure)"
  else
    next="everything looks set up. Daily use: uu enter · uu work --list · uu tenant new <name>"
  fi
  echo "next: $next"
  echo "hint: uu help status · pending recreate? -> uu recreate <box> · full check -> uu doctor"
}

cmd_logs() {
  local args=(-u llm_server --no-pager -n 50)
  while [ "$#" -gt 0 ]; do case "$1" in
    -f) args+=(-f) ;; -n) shift; [ -n "${1:-}" ] || pre "-n needs a number" "uu logs -n 200"; args+=(-n "$1") ;;
    *) pre "unknown logs flag '$1'" "uu logs [-f] [-n N]" ;;
  esac; shift; done
  host_run journalctl --user "${args[@]}"
}

cmd_help() {
  local topic="${1:-}"
  case "$topic" in
    "")        overview ;;
    --agent)   agent_help ;;
    *)         verb_help "$topic" || { printf 'uu: no help topic "%s"\n' "$topic" >&2; suggest "$topic"; exit 1; } ;;
  esac
}

# ---------- thin facades ----------
cmd_enter() {
  local box="${1:-os_agent}"
  in_box && pre "you are already inside '$(box_name)'" "exit this box first, then: uu enter $box"
  have distrobox || pre "distrobox is not installed on this host" "uu setup   # prints the exact install command"
  # Verify the box exists BEFORE calling enter: `distrobox enter` on a missing name offers to
  # create a generic fedora-toolbox box, which is never what you want here.
  # Capture before matching: `producer | grep -q` short-circuits, the producer takes SIGPIPE, and
  # under `set -o pipefail` the pipeline reports failure even on a match — which here would
  # refuse to enter a box that exists. See the pipefail note in CLAUDE.md.
  local box_names; box_names="$(distrobox list --no-color 2>/dev/null | awk -F'|' 'NR>1{gsub(/ /,"",$2); print $2}')"
  grep -qx "$box" <<<"$box_names" \
    || pre "no box named '$box'" "uu status   # to see the boxes · uu setup   # to create them"
  exec distrobox enter "$box"
}

# ---------- agent ----------
# Launch a coding agent ON THIS PROJECT. The destination is fixed on purpose: always the admin
# box, always the repo root. That is the whole value of the verb.
#
#   · always the admin box — a tenant box is a different trust domain, and the repo is mounted
#     read-only there. Reaching from a client's box into the box that maintains the system is
#     what the wall exists to prevent, so we refuse rather than quietly cross it. It would in
#     fact WORK from a tier-0/1 box (same user, host-exec reaches the host) and be impossible
#     from tier-2a (different UID, mode-700 profile); refusing makes every tier behave alike.
#   · always the repo root — agents index their history by the directory they were launched
#     from. A fixed directory means one session list instead of one per folder you happened to
#     be standing in, so `--sessions` can always find your history.
#
# No workdir flag, deliberately: the moment this takes a directory it becomes a worse `uu work`.

# config key -> binary. 'claude_code: true' in config.yaml ships the 'claude' binary.
agent_bin() { printf '%s' "${1%_code}"; }

# Enabled agents, read from config.yaml so a newly added agent appears with no change here.
# Falls back to whatever is on PATH when the repo is not reachable (installed copy of uu).
agent_list() {
  local r
  if r="$(repo_root)" && [ -f "$r/config.yaml" ]; then
    sed -n '/^agents:/,/^[a-z]/p' "$r/config.yaml" | sed -n 's/^  \([a-z0-9_]*\): *true.*/\1/p' \
      | while read -r k; do printf '%s\n' "$(agent_bin "$k")"; done
    return 0
  fi
  local b
  for b in claude codex opencode pi omp hermes; do have "$b" && printf '%s\n' "$b"; done
}

# Resume support differs per agent and is only claimed where it has been verified against the
# real --help. An agent absent from this table still launches; it just cannot resume from here.
#   claude: -c continue · -r [id] resume-or-picker
#   codex : resume --last continue · resume picker
agent_supports_resume() { case "$1" in claude|codex) return 0 ;; *) return 1 ;; esac; }

agent_resume_argv() {         # <bin> <mode: continue|pick|id> [id]
  case "$1:$2" in
    claude:continue) printf '%s\n' -c ;;
    claude:pick)     printf '%s\n' -r ;;
    claude:id)       printf '%s\n' -r "$3" ;;
    codex:continue)  printf '%s\n' resume --last ;;
    codex:pick)      printf '%s\n' resume ;;
    codex:id)        printf '%s\n' resume "$3" ;;
  esac
}

# Claude stores transcripts per launch directory, encoding it by replacing / and _ with -.
agent_session_dir() { printf '%s/.claude/projects/%s' "$HOME" "$(printf '%s' "$1" | tr '/_' '--')"; }

agent_sessions() {            # list recoverable sessions for <dir>, newest first
  local dir="$1" sdir; sdir="$(agent_session_dir "$dir")"
  [ -d "$sdir" ] || { echo "no sessions recorded yet for $dir"; return 0; }
  printf '%-38s %-17s %8s  %s\n' "SESSION ID" "LAST ACTIVE" "SIZE" "STARTED WITH"
  local f id when size first
  # shellcheck disable=SC2012  # ls -t is the ordering we want and names here are UUIDs
  for f in $(ls -t "$sdir"/*.jsonl 2>/dev/null); do
    id="$(basename "$f" .jsonl)"
    when="$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)"
    size="$(du -h "$f" 2>/dev/null | cut -f1)"
    # First human line, best effort: enough to recognise the conversation, never fatal.
    first="$(grep -m1 -o '"content":"[^"]\{8,120\}' "$f" 2>/dev/null | cut -c13- | tr -d '\n')"
    printf '%-38s %-17s %8s  %s\n' "$id" "$when" "$size" "${first:-—}"
  done
  echo
  echo "resume:  uu agent claude --session <id>     continue the newest:  uu agent claude -c"
}

cmd_agent() {
  local want="" mode=launch sid="" do_list=no do_sessions=no a
  local -a passthru=(); passthru=()
  while [ "$#" -gt 0 ]; do a="$1"; shift; case "$a" in
    --list)      do_list=yes ;;
    --sessions)  do_sessions=yes ;;
    --session)   mode=id; sid="${1:-}"; shift || true
                 [ -n "$sid" ] || pre "--session needs a session id" "uu agent --sessions   # to see them" ;;
    -c|--continue) mode=continue ;;
    -r|--resume) mode=pick ;;
    --)          passthru+=("$@"); break ;;
    -*)          passthru+=("$a") ;;
    *)           [ -z "$want" ] && want="$a" || passthru+=("$a") ;;
  esac; done

  if [ "$do_list" = yes ]; then
    printf '%-12s %-10s %s\n' AGENT RESUME STATUS
    local b
    while read -r b; do
      [ -n "$b" ] || continue
      printf '%-12s %-10s %s\n' "$b" "$(agent_supports_resume "$b" && echo yes || echo no)" \
        "$(have "$b" && command -v "$b" || echo 'not installed in this box')"
    done <<<"$(agent_list)"
    echo; echo "launch:  uu agent <name>          default: $(head -1 <<<"$(agent_list)")"
    return 0
  fi

  local repo; repo="$(repo_root)" || pre "cannot find the project files" "uu repair   # records where they are"
  [ "$do_sessions" = yes ] && { agent_sessions "$repo"; return 0; }

  local enabled; enabled="$(agent_list)"          # capture once: see the pipefail note above
  local bin="${want:-$(head -1 <<<"$enabled")}"
  grep -qx "$bin" <<<"$enabled" || pre "'$bin' is not an enabled agent" "uu agent --list"
  if [ "$mode" != launch ] && ! agent_supports_resume "$bin"; then
    pre "resuming is not wired up for '$bin' here" "launch it and use its own resume: uu aliases agents"
  fi

  local -a argv=("$bin")
  [ "$mode" != launch ] && while read -r a; do argv+=("$a"); done <<<"$(agent_resume_argv "$bin" "$mode" "$sid")"
  [ "${#passthru[@]}" -gt 0 ] && argv+=("${passthru[@]}")

  if in_box; then
    [ "$(box_name)" = "$ADMIN_BOX" ] || pre \
      "you are in '$(box_name)', and '$bin' would edit the system project — that belongs to $ADMIN_BOX" \
      "from a host terminal:  uu agent $bin"
    cd "$repo" || pre "cannot enter $repo" "uu repair"
    exec "${argv[@]}"
  fi
  have distrobox || pre "distrobox is not installed on this host" "uu setup"
  box_exists "$ADMIN_BOX" || pre "no box named '$ADMIN_BOX'" "uu setup   # creates it"
  # Never bare `distrobox enter <name>` without the existence check above: on a missing name it
  # offers to create a generic fedora-toolbox box instead of failing.
  exec distrobox enter "$ADMIN_BOX" -- bash -lc 'cd "$1" || exit 1; shift; exec "$@"' _ "$repo" "${argv[@]}"
}

cmd_work() {
  in_box || pre "work runs INSIDE a tenant box" "uu enter <box> first"
  if have work; then exec work "$@"; fi
  local r; r="$(repo_root)" && [ -f "$r/setup/lib/work.sh" ] && exec bash "$r/setup/lib/work.sh" "$@"
  pre "the 'work' launcher is not deployed in this profile" "re-run deploy-uu for this profile (admin: bash setup/lib/deploy-uu.sh \$HOME)"
}

cmd_validate()  { need_repo; exec bash "$REPO/setup/lib/validate.sh"; }
cmd_bootstrap() { need_repo; exec bash "$REPO/setup/lib/bootstrap.sh"; }

cmd_setup() {
  need_repo
  # The installer builds images and creates boxes — it must run on the host. Read-only modes
  # are fine from anywhere, so only redirect the ones that actually change something.
  local readonly_mode=no a
  for a in "$@"; do case "$a" in --status|--dry-run) readonly_mode=yes ;; esac; done
  if in_box && [ "$readonly_mode" = no ]; then
    cat >&2 <<EOF
[human-required] Setup builds images and creates boxes, so it must run on your computer —
a box cannot build itself. Open a normal terminal window and run:

    bash ${REPO#/run/host}/install.sh

(from in here you can still look: uu setup --status)
EOF
    exit 2
  fi
  bash "$REPO/install.sh" "$@"
}

# cmd_repair — fix THIS profile (the one whose $HOME we are in). Runs happily inside a box,
# which is exactly where the symptom shows up ("uu works but the shortcuts don't").
cmd_repair() {
  need_repo
  echo "repairing profile: $HOME"
  local d rc=0
  for d in deploy-aliases deploy-tmux deploy-uu; do
    [ -f "$REPO/setup/lib/$d.sh" ] || continue
    if bash "$REPO/setup/lib/$d.sh" "$HOME" 2>&1 | sed 's/^/  /'; then :; else rc=1; fi
  done
  # Record where the project lives so the installed copy of uu can find it later.
  mkdir -p "$HOME/.config/uumami" && printf '%s\n' "$REPO" > "$HOME/.config/uumami/repo"
  echo "  recorded project location: $REPO"

  # A box made by hand (as the old instructions told you to) has no session list, so `work`
  # cannot run. Create a sensible default rather than leaving the user with an error.
  local desc="$HOME/.config/uumami/tenant.yaml"
  if [ ! -f "$desc" ]; then
    local bname; bname="$(box_name)"; [ -n "$bname" ] || bname="$(basename "$HOME")"
    cat > "$desc" <<EOF
# Session list for this box (created by 'uu repair'). Edit freely, then: work --list
name: $bname
tier: "0"
model: ""
browser: shared
sessions:
  - {name: main, agent: opencode, workdir: .}
EOF
    echo "  created a starter session list ($desc) — see it with: work --list"
  fi
  # SSH is deliberately NOT auto-run: it must prompt for a passphrase (see deploy-ssh.sh).
  [ -f "$HOME/.ssh/id_ed25519_github" ] || echo "  note: no GitHub key in this profile yet — run: uu github setup"
  echo
  echo "done. Reload your shell so the shortcuts take effect:  exec bash"
  echo "then check them with: uu aliases"
  return "$rc"
}

cmd_build() {
  local img="${1:-}"; [ -n "$img" ] || pre "build needs an image name" "uu build dev_base · see \`uu help build\`"
  need_repo
  host_run bash "$REPO/setup/lib/build.sh" "$img"
}

cmd_rebuild() {
  if [ "${1:-}" = --dry-run ]; then
    echo "would: assemble + rebuild image dev_base (from images/dev_base/modules + config toggles)"
    echo "would: rebuild every derived image (os_agent + registry tenants with an image dir)"
    echo "would: PRINT the human-run recreate commands (uu never recreates a box implicitly)"
    echo "untouched: running boxes, profiles, models, code (recreates are yours to run)"
    echo "hint: run without --dry-run to build; afterwards run \`uu clean\` to drop old images"
    return 0
  fi
  need_repo
  host_run bash "$REPO/setup/lib/rebuild.sh"
}

cmd_github() {
  local key="$HOME/.ssh/id_ed25519_github"
  if [ "${1:-}" = setup ]; then
    need_repo
    # Interactive on purpose: this is where the passphrase gets typed.
    exec bash "$REPO/setup/lib/deploy-ssh.sh" "$HOME"
  fi
  echo "GitHub SSH state for this profile ($HOME):"
  if [ -f "$key" ]; then
    echo "  key       : $key (present)"
    ssh-keygen -y -P "" -f "$key" >/dev/null 2>&1 \
      && echo "  passphrase: NONE — this is a plaintext credential. Add one: ssh-keygen -p -f $key" \
      || echo "  passphrase: set"
  else
    printf '  %s\n' "key       : MISSING" >&2
    printf 'hint: %s\n' "uu github setup   # creates it (asks for a passphrase)" >&2
    exit 3; fi
  if grep -qs 'Host github.com' "$HOME/.ssh/config"; then echo "  ssh config: github.com block present"
  else echo "  ssh config: github.com block MISSING (re-run deploy-ssh)"; fi
  echo "finish (once per profile):"
  echo "  1. add the public key to GitHub:  cat $key.pub"
  echo "  2. test:                          ssh -T git@github.com"
}

cmd_doctor() {
  need_repo
  local flag=(); [ "${1:-}" = --quick ] && flag=(--quick)
  local out rc
  out="$(host_run bash "$REPO/setup/test/selftest.sh" "${flag[@]}" 2>&1)"; rc=$?
  printf '%s\n' "$out" | grep -E '✗|selftest:' || printf '%s\n' "$out" | tail -3
  if [ "$rc" -eq 0 ]; then echo "diagnosis: healthy"; else
    echo "diagnosis: the ✗ lines above are the problems"
    echo "hint: uu logs (llm issues) · uu validate (config) · docs/post-install-guide.md 'when something breaks'"
  fi
  return "$rc"
}

# ---------- models / tenant ls ----------
cmd_models() {
  local sub="${1:-ls}"; shift || true
  case "$sub" in
    ls|--json)
      if [ "$sub" = --json ] || [ "${1:-}" = --json ]; then
        UU_HTTP_TIMEOUT=5 llm_api /api/tags \
          || pre "llm endpoint not responding" "uu status · uu logs · systemctl --user status llm_server"
        echo; return 0
      fi
      # Read over HTTP, not by entering the box: fast, and it cannot trigger distrobox's
      # "create it now?" prompt when llm_server is absent.
      local tags; tags="$(UU_HTTP_TIMEOUT=5 llm_api /api/tags)" \
        || pre "llm endpoint not responding on 127.0.0.1:11434" "uu status   # is the server set up and running?"
      if ! printf '%s' "$tags" | grep -q '"name"'; then
        echo "no models downloaded yet"; echo "hint: uu models pull qwen3-coder:30b"; return 0
      fi
      printf '%s' "$tags" | grep -o '"name":"[^"]*"' | cut -d'"' -f4 | sort -u ;;
    pull|rm)
      local m="${1:-}"; [ -n "$m" ] || pre "models $sub needs a model name" "uu models   # to see what exists"
      llm_box_run ollama "$sub" "$m" ;;
    *) pre "unknown models subcommand '$sub'" "uu models [ls|pull|rm] — see \`uu help models\`" ;;
  esac
}

registry_path() {
  # profiles dir is only configurable via the repo config; default matches config.yaml
  # When running inside a distrobox, $HOME is the box's profile dir (e.g. ~/Profiles/os_agent);
  # dirname gives the shared Profiles/ directory where the registry lives.
  if [ -n "${UU_PROFILES:-}" ]; then
    printf '%s' "$UU_PROFILES/registry.yaml"
  elif in_box; then
    printf '%s' "$(dirname "$HOME")/registry.yaml"
  else
    printf '%s' "$HOME/Profiles/registry.yaml"
  fi
}

cmd_tenant_ls() {
  local as_json=no; [ "${1:-}" = --json ] && as_json=yes
  local reg; reg="$(registry_path)"
  if ! host_run test -f "$reg" 2>/dev/null; then
    if [ "$as_json" = yes ]; then echo '{"tenants":[]}'; else
      echo "no tenants registered yet"; echo "hint: uu tenant new <name>"; fi
    return 0
  fi
  local rows  # name<TAB>user<TAB>tier<TAB>image
  rows="$(host_run bash -lc 'PATH="$HOME/.local/bin:$PATH" yq -r '\''(.tenants // [])[] | [.name, .user, .tier, .image] | @tsv'\'' "$1" 2>/dev/null' -- "$reg")"
  if [ "$as_json" = yes ]; then
    printf '{"tenants":['
    local first=yes n u t i
    while IFS=$'\t' read -r n u t i; do
      [ -z "$n" ] && continue
      [ "$first" = yes ] || printf ','; first=no
      printf '{"name":"%s","user":"%s","tier":"%s","image":"%s"}' \
        "$(json_escape "$n")" "$(json_escape "$u")" "$(json_escape "$t")" "$(json_escape "$i")"
    done <<< "$rows"
    printf ']}\n'; return 0
  fi
  if ! printf '%s' "$rows" | grep -q .; then
    echo "no tenants registered yet"; echo "hint: uu tenant new <name>"; return 0
  fi
  printf '%-16s %-12s %-5s %s\n' NAME USER TIER IMAGE
  local n u t i
  while IFS=$'\t' read -r n u t i; do
    [ -n "$n" ] && printf '%-16s %-12s %-5s %s\n' "$n" "$u" "$t" "$i"
  done <<< "$rows"
}

# ---------- dispatcher ----------
main() {
  [ "$#" -eq 0 ] && { overview; exit 0; }
  local verb="$1"; shift
  case "$verb" in
    -h|--help|help) cmd_help "${1:-}"; exit 0 ;;
    -v|--version)   echo "uu $UU_VERSION"; exit 0 ;;
  esac
  # per-verb --help
  for a in "$@"; do [ "$a" = --help ] && { verb_help "$verb" || { suggest "$verb"; exit 1; }; exit 0; }; done
  case "$verb" in
    setup|repair|status|enter|agent|work|models|clean|rebuild|recreate|build|logs|github|bootstrap|validate|doctor|aliases)
      "cmd_$verb" "$@" ;;
    tenant)
      local sub="${1:-}"; shift || true
      case "$sub" in
        new|ls|rm) "cmd_tenant_$sub" "$@" ;;
        --help|"") verb_help tenant; exit 0 ;;
        *) printf 'uu: unknown tenant subcommand "%s"\n' "$sub" >&2
           printf 'hint: uu tenant new|ls|rm — see `uu help tenant`\n' >&2; exit 1 ;;
      esac ;;
    *)
      printf 'uu: unknown command "%s"\n' "$verb" >&2; suggest "$verb"; exit 1 ;;
  esac
}

# ---------- aliases catalog ----------
aliases_file() {
  [ -f "$HOME/.config/uumami/aliases.sh" ] && { printf '%s' "$HOME/.config/uumami/aliases.sh"; return 0; }
  local r; r="$(repo_root)" && [ -f "$r/setup/templates/qol/aliases.sh" ] \
    && { printf '%s' "$r/setup/templates/qol/aliases.sh"; return 0; }
  return 1
}

cmd_aliases() {
  local filter="" as_json=no a
  for a in "$@"; do case "$a" in
    --json) as_json=yes ;; agents|git|gh|tmux|containers|llm) filter="$a" ;;
    *) pre "unknown category '$a'" "categories: agents git gh tmux containers llm" ;;
  esac; done
  local f; f="$(aliases_file)" || pre "no aliases file found" "run deploy-aliases (or uu bootstrap on the admin account)"
  # rows: category<TAB>name<TAB>desc  (from '# @cat: desc' annotations)
  local rows
  rows="$(awk -F'# @' '/# @[a-z]+:/{
      split($2, m, ":"); cat=m[1]
      desc=substr($2, length(cat)+3)
      line=$1
      if (line ~ /^alias /) { sub(/^alias /,"",line); split(line, n, "=") } else { split(line, n, "\\(") }
      gsub(/^[ \t]+|[ \t]+$/, "", n[1]); gsub(/^[ \t]+|[ \t]+$/, "", desc)
      print cat "\t" n[1] "\t" desc
    }' "$f")"
  if [ "$as_json" = yes ]; then
    printf '{"aliases":['
    local first=yes c n d
    while IFS=$'\t' read -r c n d; do
      [ -z "$n" ] && continue; [ -n "$filter" ] && [ "$c" != "$filter" ] && continue
      [ "$first" = yes ] || printf ','; first=no
      printf '{"category":"%s","name":"%s","desc":"%s"}' "$(json_escape "$c")" "$(json_escape "$n")" "$(json_escape "$d")"
    done <<< "$rows"
    printf ']}\n'; return 0
  fi
  local cat c n d
  for cat in agents git gh tmux containers llm; do
    [ -n "$filter" ] && [ "$cat" != "$filter" ] && continue
    printf '%s:\n' "$cat"
    while IFS=$'\t' read -r c n d; do
      [ "$c" = "$cat" ] && printf '  %-12s %s\n' "$n" "$d"
    done <<< "$rows"
    echo
  done
  echo "hint: these work in any interactive shell in this box · uu aliases <category> to filter"
}

# ---------- mutation framework ----------
DRY=no; YES=no; REST=()
parse_mut_flags() {
  DRY=no; YES=no; REST=()
  local a; for a in "$@"; do case "$a" in
    --dry-run) DRY=yes ;; --yes|-y) YES=yes ;; *) REST+=("$a") ;;
  esac; done
}
confirm_or_die() {
  [ "$YES" = yes ] && return 0
  printf '%s [y/N] ' "$1"
  local ans; read -r ans || ans=""
  case "$ans" in y|Y|yes|YES) return 0 ;; *) die "aborted (nothing was changed)" "add --dry-run to preview, --yes to skip this prompt" 1 ;; esac
}

cmd_clean() {
  parse_mut_flags "$@"
  # plan: dangling images (would remove) / in-use (keeping) / tagged-unused (review)
  local dangling; dangling="$(host_run podman images -f dangling=true --format '{{.ID}} {{.Size}}' 2>/dev/null)"
  local inuse;    inuse="$(host_run podman ps -a --format '{{.Image}}' 2>/dev/null | sort -u)"
  local tagged;   tagged="$(host_run podman images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -v '^<none>' | sort -u)"
  echo "plan:"
  if printf '%s' "$dangling" | grep -q .; then
    printf '%s\n' "$dangling" | while read -r id sz; do echo "  would: remove dangling image $id ($sz)"; done
  else
    echo "  would: remove dangling images — none found"
  fi
  local t
  while read -r t; do
    [ -z "$t" ] && continue
    if printf '%s\n' "$inuse" | grep -qx "$t"; then echo "  keeping: $t (in use by a box)"
    else echo "  review: $t (tagged, no box uses it — uu never removes tagged images; if truly obsolete: podman rmi $t)"; fi
  done <<< "$tagged"
  echo "  untouched: profiles, models, code (different pool — see docs/housekeeping.md)"
  [ "$DRY" = yes ] && { echo "hint: run \`uu clean\` (without --dry-run) to apply"; return 0; }
  printf '%s' "$dangling" | grep -q . || { echo "nothing to clean."; return 0; }
  confirm_or_die "remove the dangling images listed above?"
  host_run podman image prune -f
  echo "done. hint: uu status   # disk line updates"
}

# ---------- recreate / tenant new / tenant rm ----------
cmd_recreate() {
  parse_mut_flags "$@"
  local box="${REST[0]:-}"; [ -n "$box" ] || pre "recreate needs a box name" "uu status   # to see the boxes"
  if in_box && [ "$(box_name)" = "$box" ]; then
    cat <<EOF
[human-required] A box cannot recreate itself. From a HOST terminal run:
  uu recreate $box
(the profile and code survive; uu never uses --rm-home)
EOF
    exit 2
  fi
  case "$box" in
    llm_server)
      need_repo
      echo "plan:"
      echo "  would: rebuild the llm_server image and recreate its box (GPU flags from the flavor)"
      echo "  keeping: the profile and the models mount (never deleted)"
      echo "  untouched: every other box"
      [ "$DRY" = yes ] && return 0
      confirm_or_die "recreate llm_server now (brief inference downtime)?"
      host_run bash "$REPO/setup/lib/llm_server.sh"
      echo "hint: systemctl --user restart llm_server ; uu status" ;;
    os_agent)
      if in_box; then
        printf '%s\n' "[human-required] recreate os_agent from a HOST terminal (paths resolve wrong inside a box)." >&2
        printf '  %s\n' "open a host terminal, then: uu recreate os_agent" >&2
        exit 2
      fi
      box_exists os_agent || pre "there is no os_agent box to recreate" "uu setup   # creates it"
      # Read the CURRENT mounts off the running box instead of assuming them. Hardcoding
      # them here once silently re-pointed /workspace at a different directory on recreate —
      # the box came back "fine" but showing the wrong code.
      local home_mnt="" vols=() src dst
      while IFS=$'\t' read -r src dst; do
        [ -z "$dst" ] && continue
        case "$dst" in
          /workspace|/containers) vols+=(--volume "$src:$dst") ;;
          "$HOME"|/home/*|/var/home/*) [ -z "$home_mnt" ] && home_mnt="$src" ;;
        esac
      done < <(hq podman inspect os_agent --format '{{range .Mounts}}{{.Source}}{{"\t"}}{{.Destination}}{{"\n"}}{{end}}')
      [ -n "$home_mnt" ] || home_mnt="$HOME/Profiles/os_agent"
      echo "plan:"
      echo "  would: distrobox rm os_agent  (never --rm-home)"
      echo "  would: distrobox create --image localhost/os_agent:latest with the SAME mounts:"
      echo "         home: $home_mnt"
      local v; for v in "${vols[@]}"; do [ "$v" = --volume ] || echo "         mount: $v"; done
      [ ${#vols[@]} -eq 0 ] && echo "         (no extra mounts found on the current box)"
      echo "  keeping: profile $home_mnt and all code (never deleted)"
      [ "$DRY" = yes ] && return 0
      confirm_or_die "recreate os_agent now (kills any session inside it)?"
      host_run distrobox rm -f os_agent
      host_run distrobox create --yes --name os_agent --image localhost/os_agent:latest \
        --home "$home_mnt" "${vols[@]}"
      echo "done. hint: distrobox enter os_agent ; uu clean   # drop the old image" ;;
    *)
      local reg u; reg="$(registry_path)"
      u="$(host_run bash -lc 'PATH="$HOME/.local/bin:$PATH" N="$2" yq -r '\''(.tenants // [])[] | select(.name == env(N)) | .user'\'' "$1" 2>/dev/null' -- "$reg" "$box")"
      [ -n "$u" ] || pre "unknown box '$box'" "uu status · uu tenant ls"
      cat <<EOF
[human-required] '$box' belongs to Linux user '$u'. As that user, rerun its setup:
  sudo -iu $u bash <repo>/setup/lib/tenant-create.sh --user-setup <manifest>
  (or: sudo -iu $u distrobox rm -f $box   # then rerun tenant-create user-setup)
EOF
      exit 2 ;;
  esac
}

cmd_tenant_new() {
  parse_mut_flags "$@"
  local name="" tier="" manifest="" i=0 n=${#REST[@]}
  while [ "$i" -lt "$n" ]; do
    case "${REST[$i]}" in
      --tier)     i=$((i+1)); tier="${REST[$i]:-}" ;;
      --manifest) i=$((i+1)); manifest="${REST[$i]:-}" ;;
      *) name="${REST[$i]}" ;;
    esac; i=$((i+1))
  done
  need_repo
  if [ -n "$manifest" ]; then
    [ -f "$manifest" ] || pre "manifest '$manifest' not found" "see setup/templates/tenant-example.yaml"
  else
    [ -n "$name" ] || pre "tenant new needs a name (or --manifest file)" "uu tenant new acme · see \`uu help tenant\`"
    case "$name" in *[!a-z0-9_-]*) pre "the name '$name' is not allowed — use only lowercase letters, numbers, dashes and underscores" "e.g. uu tenant new acme-corp";; esac
    # The manifest MUST outlive this command. A tier >= 2a tenant exits 2 and tells the human to
    # re-run `--user-setup <manifest>` after creating the Linux user — instructions that are
    # useless if the file was a temp file we deleted on the way out (it was).
    local mdir="${XDG_CONFIG_HOME:-$HOME/.config}/uumami/tenants"
    mkdir -p "$mdir" 2>/dev/null || true
    manifest="$mdir/$name.yaml"
    if [ -f "$manifest" ]; then
      echo "reusing the existing description for '$name' ($manifest)"
    else
      { echo "# Description of the '$name' project space, created by 'uu tenant new'."
        echo "# Edit it and re-apply any time with:  uu tenant new --manifest $manifest"
        echo "name: $name"; [ -n "$tier" ] && echo "tier: \"$tier\""
        echo "browser: per-tenant"
        echo "sessions:"; echo "  - {name: ${name}-main, agent: opencode, workdir: .}"
      } > "$manifest"
      echo "saved the description for '$name' to $manifest"
      echo "  (for all the options, copy setup/templates/tenant-example.yaml over it)"
    fi
  fi
  local flags=(); [ "$DRY" = yes ] && flags+=(--dry-run)
  host_run bash "$REPO/setup/lib/tenant-create.sh" "${flags[@]}" "$manifest"
  local rc=$?
  [ "$rc" -eq 2 ] && echo "hint: run the printed sudo commands, then the --user-setup line (this is the ONLY sudo step)"
  return "$rc"
}

cmd_tenant_rm() {
  parse_mut_flags "$@"
  local name="" wipe_profile=no a
  for a in "${REST[@]}"; do case "$a" in
    --profile) wipe_profile=yes ;; *) name="$a" ;;
  esac; done
  [ -n "$name" ] || pre "tenant rm needs a name" "uu tenant ls"
  case "$name" in *[!a-z0-9_-]*) pre "the name '$name' is not allowed — use only lowercase letters, numbers, dashes and underscores" "uu tenant ls";; esac
  local reg profdir
  reg="$(registry_path)"
  profdir="$(dirname "$reg")/$name"
  echo "plan:"
  echo "  would: distrobox rm -f $name            (the box; its writable layer is freed)"
  echo "  would: remove '$name' from the registry ($reg)"
  if [ "$wipe_profile" = yes ]; then
    echo "  would: DELETE the profile $profdir     (credentials/sessions — NO UNDO)"
  else
    echo "  keeping: the profile $profdir (credentials survive; pass --profile to delete it)"
  fi
  echo "  untouched: models, code, other tenants"
  [ "$DRY" = yes ] && { echo "hint: run without --dry-run to apply"; return 0; }
  confirm_or_die "decommission tenant '$name'?"
  host_run distrobox rm -f "$name" 2>/dev/null || echo "  (no box named '$name' — continuing)"
  host_run bash -lc 'PATH="$HOME/.local/bin:$PATH" N="$2" yq -i '\''del(.tenants[] | select(.name == env(N)))'\'' "$1" 2>/dev/null' -- "$reg" "$name" || true
  echo "  box + registry entry removed."
  if [ "$wipe_profile" = yes ]; then
    # No-undo step: ALWAYS retype the name, even with --yes (spec §4).
    printf 'to DELETE the profile (no undo), retype the tenant name: '
    local typed; read -r typed || typed=""
    [ "$typed" = "$name" ] || die "name mismatch — profile NOT deleted" "profile kept at $profdir" 1
    [ -d "$profdir" ] || pre "no profile at $profdir (tier-2a profiles are the tenant user's home — remove via 'sudo userdel -r' deliberately)" ""
    host_run rm -rf -- "$profdir"
    echo "  profile deleted."
  fi
  echo "done. hint: if this was a tier-2a tenant, also (deliberately): sudo userdel -r <user> · their image store frees with: sudo -iu <user> podman image prune"
}

main "$@"
