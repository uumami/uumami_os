# module:  omp
# toggle:  agents.omp
# summary: oh-my-pi (npm `@oh-my-pi/pi-coding-agent`; binary `omp`) — a Pi fork.
# Terminal-first with IDE capability wired in (LSP/DAP/ACP/Zed + web collab).
# Local Ollama via ~/.omp/agent/models.yml (type: openai-compatible, baseUrl .../v1).
# Exact models.yml schema confirmed in the spike (SG7 post-install guide).
# SPIKE FINDING: omp's bin shim is executed by `bun`, not node — `omp` fails with
# "env: 'bun': No such file or directory" unless bun is on PATH. Install bun first.
RUN npm install -g bun@1.3.14 \
 && npm install -g @oh-my-pi/pi-coding-agent@16.1.18
